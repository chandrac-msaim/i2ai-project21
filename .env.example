# Copy this file to .env and keep the defaults for local use. Never commit .env.

# --- Database (matches docker-compose.yml) ---
POSTGRES_USER=graydi
POSTGRES_PASSWORD=graydi_dev_pw
POSTGRES_DB=graydi
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://graydi:graydi_dev_pw@localhost:5432/graydi

# --- LLM: local Ollama (run: ollama pull qwen2.5:3b) ---
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ANTHROPIC_API_KEY=            # only if LLM_PROVIDER=claude

# --- Embeddings: MiniLM, downloaded from Hugging Face on first use (needs internet once) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# After the model is downloaded you may add HF_HUB_OFFLINE=1 to skip network lookups.
# Do NOT set it before the first download: it blocks the download.

# --- Email: Mailpit local inbox (http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=advising@demo.graydi.local
# Only for the tests, if Mailpit runs on another port:
# MAILPIT_API_URL=http://localhost:8025/api/v1

# --- Link used in the approval email ---
FRONTEND_URL=http://localhost:5173

# --- Auth: development only. Replace with your own random value if you ever deploy ---
JWT_SECRET=change-me-dev-only

# --- App ---
APP_ENV=development
# Demo date. Spring 2027 demo (default): 2026-11-07. Fall 2026 demo: 2026-07-15. Empty = real date.
# Restart the backend after changing it.
APP_TODAY=2026-11-07
